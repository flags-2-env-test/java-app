// Fifteen compiled Oreslang actors; fourteen forward/backward hops.
// Each downstream actor adds one; backward stages add one; expected 30.
define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeMessages as
    Signal.Data
    Signal.Result
end
define match pattern PipeForwardMessages as
    Signal.Data
end
define match pattern PipeBackwardMessages as
    Signal.Result
end

define actor Stage0<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(|state| -> { return state.value + n + 1; });
                self.forward(Signal.Data(next));
            }
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
            }
        }
        return next;
    }
end
define transform pipe actor Stage1<forward_messages=PipeForwardMessages,backward_messages=PipeBackwardMessages> as
    state { value: int = 0; }
    receive_forward(PipeForwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.forward(Signal.Data(next));
            }
        }
        return;
    }
    receive_backward(PipeBackwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.backward(Signal.Result(next));
            }
        }
        return;
    }
end
