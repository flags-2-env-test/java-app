// Returning state.value is an actual read, even if the loan first writes.
define enum Update as
    Reset: int = 1
end
define match pattern Updates as
    Update.Reset
end
define actor Recorder<messages=Updates> as
    state { value: int = 40; }
    receive(Updates m) with state.write {
        do match m over {
            on Update.Reset as n {
                const result = self.handle_state(critical |state| -> {
                    state.value = n;
                    return state.value;
                });
            }
        }
        return result;
    }
end
