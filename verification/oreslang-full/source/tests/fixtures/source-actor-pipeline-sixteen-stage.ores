// Maximum admitted linear route: 16 distinct compiled Oreslang actors.
// Each downstream actor adds one; backward stages add one; expected 32.
define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeMessages as
    Signal.Data
    Signal.Result
end

define actor Stage0<messages=PipeMessages> as
    let value: int = 0;
    receive(PipeMessages m) {
        do match m over {
            on Signal.Data as n {
                value = n + 1;
                self.forward(Signal.Data(value));
            }
            on Signal.Result as n {
                value = n + 1;
            }
        }
        return value;
    }
end
define actor Stage1<messages=PipeMessages> as
    let value: int = 0;
    receive(PipeMessages m) {
        do match m over {
            on Signal.Data as n {
                value = n + 1;
                self.forward(Signal.Data(value));
            }
            on Signal.Result as n {
                value = n + 1;
                self.backward(Signal.Result(value));
            }
        }
        return value;
    }
end
