// Guest continuation must execute on the root supervisor CONTROL lane.
// The externally invoked main may join while no ActorGroup carrier blocks.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  await worker.get_ready();
  worker.send(1);
  worker.send(2);
  stop worker;
  return 43;
}
