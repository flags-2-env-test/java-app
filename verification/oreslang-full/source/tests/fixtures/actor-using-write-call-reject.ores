define enum Signal as
    Data: int = 1
end
define match pattern PipeMessages as
    Signal.Data
end
define actor Probe<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) {
        do match m over {
            on Signal.Data as n {
                const next = using state.write(critical |state| -> { state.value = increment(n); return state.value; });
            }
        }
        return 0;
    }
end

pub fnc increment(int x): int { return x + 1; }
