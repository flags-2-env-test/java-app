define enum Signal as
    Data: int = 1
end
define match pattern PipeMessages as
    Signal.Data
end
define actor Probe<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(|state| -> { state.value = n; return state.value; });
            }
        }
        return 0;
    }
end
