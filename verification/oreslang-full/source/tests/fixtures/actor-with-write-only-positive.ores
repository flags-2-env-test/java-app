define enum Signal as
    Data: int = 1
end
define match pattern PipeMessages as
    Signal.Data
end
define actor Probe<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return 4; });
            }
        }
        return 0;
    }
end
