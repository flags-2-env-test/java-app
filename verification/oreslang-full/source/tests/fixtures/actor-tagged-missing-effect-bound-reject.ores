// A sealed callback in tagged receive requires an explicit with upper bound.
// Missing the row must never act like automatic state.read/write admission.
define enum Update as
    Reset: int = 1
end
define match pattern Updates as
    Update.Reset
end
define actor Recorder<messages=Updates> as
    state { value: int = 0; }
    receive(Updates m) {
        do match m over {
            on Update.Reset as n {
                const next = self.handle_state(critical |state| -> {
                    state.value = n;
                    return n;
                });
            }
        }
        return next;
    }
end
