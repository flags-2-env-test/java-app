// Module-local message contract, actor and executable entrypoint.
define module Bar as
    declare type match Signals as
        bool
    end
    define actor Foo<messages=Signals> as
        let total: int = 0;
        receive(Signals m) {
            total = total + 1;
            return total;
        }
    end
    pub fnc main(): int {
        const worker: ActorRef<Foo> = spawn Foo();
        worker.send(true);
        worker.send(false);
        stop worker;
        return 43;
    }
end
